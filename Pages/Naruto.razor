
@page "/naruto"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<PageTitle>Personagens Naruto</PageTitle>

<h1>Personagens de Naruto</h1>

<p>Consulte os personagens da API Dattebayo.</p>

<div class="mb-3">
    <input class="form-control"
           placeholder="Digite o nome do personagem"
           @bind="nomeBusca"
           @bind:event="oninput" />
</div>

<button class="btn btn-primary mb-3"
        @onclick="BuscarPersonagens">
    Buscar
</button>

@if (carregando)
{
    <p>Carregando personagens...</p>
}
else if (!string.IsNullOrEmpty(erro))
{
    <p class="text-danger">@erro</p>
}
else if (personagens.Count == 0)
{
    <p>Nenhum personagem encontrado.</p>
}
else
{
    <div class="row">
        @foreach (var personagem in personagens)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    @if (personagem.Imagens.Count > 0)
                    {
                        <img src="@personagem.Imagens[0]"
                             alt="@personagem.Nome"
                             style="height:250px;object-fit:contain" />
                    }

                    <div class="card-body">
                        <h3>@personagem.Nome</h3>

                        <p><b>Clã:</b> @personagem.Cla</p>
                        <p><b>Afiliação:</b> @personagem.Afiliacao</p>
                        <p><b>Patente:</b> @personagem.Patente</p>

                        <h5>Jutsus</h5>

                        @if (personagem.Jutsus.Count > 0)
                        {
                            <ul>
                                @foreach (var jutsu in personagem.Jutsus)
                                {
                                    <li>@jutsu</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>Não informado.</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-secondary"
            disabled="@(pagina <= 1 || carregando)"
            @onclick="PaginaAnterior">
        Anterior
    </button>

    <span>Página @pagina</span>

    <button class="btn btn-secondary"
            disabled="@(!temProxima || carregando)"
            @onclick="ProximaPagina">
        Próxima
    </button>
</div>

@code {
    private string nomeBusca = "";
    private string erro = "";
    private int pagina = 1;
    private bool carregando = false;
    private bool temProxima = false;

    private List<Personagem> personagens = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarPersonagens();
    }

    private async Task BuscarPersonagens()
    {
        pagina = 1;
        await CarregarPersonagens();
    }

    private async Task PaginaAnterior()
    {
        if (pagina > 1)
        {
            pagina--;
            await CarregarPersonagens();
        }
    }

    private async Task ProximaPagina()
    {
        if (temProxima)
        {
            pagina++;
            await CarregarPersonagens();
        }
    }

    private async Task CarregarPersonagens()
    {
        carregando = true;
        erro = "";
        personagens.Clear();

        try
        {
            string url = $"characters?page={pagina}&limit=10";

            if (!string.IsNullOrWhiteSpace(nomeBusca))
            {
                url += $"&name={Uri.EscapeDataString(nomeBusca.Trim())}";
            }

            using var resposta = await Http.GetAsync(url);
            resposta.EnsureSuccessStatusCode();

            using var json = await resposta.Content
                .ReadFromJsonAsync<JsonDocument>();

            if (json == null)
                return;

            var raiz = json.RootElement;

            if (!raiz.TryGetProperty("characters", out var lista))
                return;

            foreach (var item in lista.EnumerateArray())
            {
                var personagem = new Personagem
                {
                    Nome = LerTexto(item, "name"),
                    Imagens = LerLista(item, "images"),
                    Jutsus = LerLista(item, "jutsu")
                };

                if (item.TryGetProperty("personal", out var personal))
                {
                    personagem.Cla = LerTexto(personal, "clan");
                    personagem.Afiliacao = LerTexto(personal, "affiliation");
                }

                if (item.TryGetProperty("rank", out var rank))
                {
                    personagem.Patente = LerTexto(rank, "ninjaRank");
                }

                personagens.Add(personagem);
            }

            temProxima = personagens.Count == 10;
        }
        catch (Exception ex)
        {
            erro = "Erro ao consultar API: " + ex.Message;
        }
        finally
        {
            carregando = false;
        }
    }

    private static string LerTexto(JsonElement objeto, string campo)
    {
        if (objeto.ValueKind != JsonValueKind.Object ||
            !objeto.TryGetProperty(campo, out var valor))
            return "Não informado";

        if (valor.ValueKind == JsonValueKind.String)
            return valor.GetString() ?? "Não informado";

        if (valor.ValueKind == JsonValueKind.Array)
            return string.Join(", ", valor.EnumerateArray()
                .Select(x => x.ToString()));

        if (valor.ValueKind == JsonValueKind.Object)
            return string.Join(", ", valor.EnumerateObject()
                .Select(x => $"{x.Name}: {x.Value}"));

        return valor.ToString();
    }

    private static List<string> LerLista(JsonElement objeto, string campo)
    {
        if (objeto.ValueKind != JsonValueKind.Object ||
            !objeto.TryGetProperty(campo, out var valor) ||
            valor.ValueKind != JsonValueKind.Array)
            return new();

        return valor.EnumerateArray()
            .Select(x => x.ToString())
            .ToList();
    }

    public class Personagem
    {
        public string Nome { get; set; } = "";
        public string Cla { get; set; } = "";
        public string Afiliacao { get; set; } = "";
        public string Patente { get; set; } = "";
        public List<string> Imagens { get; set; } = new();
        public List<string> Jutsus { get; set; } = new();
    }
}
